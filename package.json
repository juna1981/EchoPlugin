{
  "name": "echo-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación Ionic Angular con envoltorio de Electron usando Capacitor",
  "scripts": {
    "start": "ionic serve",
    "build": "ng build",
